rule("ROUND — ИНИЦИАЛИЗАЦИЯ")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Set Match Time(300);
		Pause Match Time;
		Disable Built-In Game Mode Completion;
	}
}

rule("ROUND — СТАРТ ТАЙМЕРА")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
	}

	actions
	{
		Set Match Time(300);
		Unpause Match Time;
	}
}

rule("ROUND — ВРЕМЯ ВЫШЛО — ПЕРЕЗАПУСК")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
		Match Time <= 0;
	}

	actions
	{
		Big Message(All Players(All Teams), Custom String("РАУНД ОКОНЧЕН!"));
		Wait(3, Ignore Condition);
		Restart Match;
	}
}

rule("- MAP STATS ;")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		Все;
	}

	conditions
	{
		Is In Spawn Room(Event Player) == True;
		Count Of(Global.X) > 0;
	}

	actions
	{
		Teleport(Event Player, Nearest Walkable Position(Random Value In Array(Global.X)));
		Wait(5, Abort When False);
		Loop If Condition Is True;
	}
}

rule("DEBUG — КД АБИЛОК МАКС 5 СЕК")
{
	event
	{
		Ongoing - Each Player;
		All;
		Все;
	}

	conditions
	{
		Is Alive(Event Player) == True;
	}

	actions
	{
		If(Ability Cooldown(Event Player, Button(Ability 1)) > 5);
			Set Ability Cooldown(Event Player, Button(Ability 1), 5);
		End;
		If(Ability Cooldown(Event Player, Button(Ability 2)) > 5);
			Set Ability Cooldown(Event Player, Button(Ability 2), 5);
		End;
		Wait(0.250, Ignore Condition);
		Loop If Condition Is True;
	}
}


rule("MAUGA — СКОРОСТЬ БАЗОВАЯ")
{
	event
	{
		Ongoing - Each Player;
		All;
		Мауга;
	}

	conditions
	{
		Is Alive(Event Player) == True;
		Is Using Ability 1(Event Player) == False;
	}

	actions
	{
		Set Move Speed(Event Player, 110);
	}
}

rule("MAUGA — СКОРОСТЬ ШИФТ")
{
	event
	{
		Ongoing - Each Player;
		All;
		Мауга;
	}

	conditions
	{
		Is Using Ability 1(Event Player) == True;
	}

	actions
	{
		Set Move Speed(Event Player, 120);
	}
}

rule("MAUGA — БЛОК НАТИВНОЙ УЛЬТЫ")
{
	event
	{
		Ongoing - Each Player;
		All;
		Мауга;
	}

	conditions
	{
		Has Spawned(Event Player) == True;
	}

	actions
	{
		Disallow Button(Event Player, Button(Ultimate));
	}
}

rule("MAUGA — СТАРТ ЗАРЯДКИ УЛЬТЫ")
{
	event
	{
		Ongoing - Each Player;
		All;
		Мауга;
	}

	conditions
	{
		Event Player.N == 0;
		Is Alive(Event Player) == True;
	}

	actions
	{
		Event Player.X = 0;
		Chase Player Variable Over Time(Event Player, X, 100, 5, Destination and Duration);
	}
}

rule("MAUGA — СИНК ЗАРЯДА УЛЬТЫ")
{
	event
	{
		Ongoing - Each Player;
		All;
		Мауга;
	}

	conditions
	{
		Has Spawned(Event Player) == True;
	}

	actions
	{
		If(Event Player.N == 0);
			Set Ultimate Charge(Event Player, Event Player.X);
		End;
		Wait(0.050, Ignore Condition);
		Loop;
	}
}

rule("MAUGA — УЛЬТ БРОСОК")
{
	event
	{
		Ongoing - Each Player;
		All;
		Мауга;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Event Player.X >= 100;
		Event Player.N == 0;
	}

	actions
	{
		Event Player.N = 1;
		Stop Chasing Player Variable(Event Player, X);
		Set Ultimate Charge(Event Player, 0);
		Apply Impulse(Event Player, Facing Direction Of(Event Player), 25, To World, Cancel Contrary Motion);
	}
}

rule("MAUGA — УЛЬТ ПРИЗЕМЛЕНИЕ — КУПОЛ")
{
	event
	{
		Ongoing - Each Player;
		All;
		Мауга;
	}

	conditions
	{
		Event Player.N == 1;
		Is On Ground(Event Player) == True;
	}

	actions
	{
		Event Player.N = 2;
		Create Effect(All Players(All Teams), Sphere, Color(Белый), Event Player, 8, Visible To Position and Radius);
		Event Player.E = Last Created Entity;
		Event Player.T = 8;
		Chase Player Variable Over Time(Event Player, T, 0, 8, Destination and Duration);
	}
}

rule("MAUGA — КУПОЛ ЛОВУШКА")
{
	event
	{
		Ongoing - Each Player;
		All;
		Мауга;
	}

	conditions
	{
		Event Player.N == 2;
	}

	actions
	{
		For Player Variable(Event Player, I, 0, Count Of(All Players(Opposite Team Of(Team Of(Event Player)))), 1);
			If(Distance Between(Position Of(Event Player), Position Of(All Players(Opposite Team Of(Team Of(Event Player)))[Event Player.I])) > 8);
				Teleport(All Players(Opposite Team Of(Team Of(Event Player)))[Event Player.I], Nearest Walkable Position(Position Of(Event Player) + Direction Towards(Event Player, All Players(Opposite Team Of(Team Of(Event Player)))[Event Player.I]) * 6));
			End;
			If(Distance Between(Position Of(Event Player), Position Of(All Players(Opposite Team Of(Team Of(Event Player)))[Event Player.I])) > 6);
				Apply Impulse(All Players(Opposite Team Of(Team Of(Event Player)))[Event Player.I], Direction Towards(All Players(Opposite Team Of(Team Of(Event Player)))[Event Player.I], Event Player), 10, To World, Cancel Contrary Motion);
			End;
		End;
		Wait(0.050, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("MAUGA — КУПОЛ ЗАВЕРШЕН")
{
	event
	{
		Ongoing - Each Player;
		All;
		Мауга;
	}

	conditions
	{
		Event Player.N == 2;
		Event Player.T <= 0;
	}

	actions
	{
		Destroy Effect(Event Player.E);
		Stop Chasing Player Variable(Event Player, T);
		Event Player.N = 0;
		Event Player.X = 0;
		Set Ultimate Charge(Event Player, 0);
		Chase Player Variable Over Time(Event Player, X, 100, 5, Destination and Duration);
	}
}

rule("MAUGA — КУПОЛ ОТМЕНА ПРИ СМЕРТИ")
{
	event
	{
		Player Died;
		All;
		Мауга;
	}

	conditions
	{
		Event Player.N == 2;
	}

	actions
	{
		Destroy Effect(Event Player.E);
		Stop Chasing Player Variable(Event Player, T);
		Event Player.N = 0;
		Event Player.X = 0;
		Set Ultimate Charge(Event Player, 0);
	}
}
