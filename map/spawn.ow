// ============================================
// MAP — Правила карты и спавна
// ============================================

rule("- MAP STATS ;")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		Все;
	}

	conditions
	{
		Is In Spawn Room(Event Player) == True;
		Count Of(Global.X) > 0;
	}

	actions
	{
		Teleport(Event Player, Nearest Walkable Position(Random Value In Array(Global.X)));
		Wait(5, Abort When False);
		Loop If Condition Is True;
	}
}
